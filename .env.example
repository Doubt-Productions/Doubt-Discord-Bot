# Toggles
PRODUCTION=false

# Important Settings
CLIENT_TOKEN=
CLIENT_ID=
# Include /dbname in the path, or the bot appends config.variables.dbName (production/development)
MONGODB_URI=

# Guild Settings
GUILD_ID= 
DEV_GUILD_ID= 

# Dev Settings
DEV_TOKEN=
DEV_CLIENT_ID=
# Include /dbname in the path, or the bot appends config.variables.dbName (production/development)
DEV_MONGODB_URI=

# Prisma (uses DEV_MONGODB_URI or MONGODB_URI depending on PRODUCTION flag)
# DATABASE_URL is read by Prisma CLI tools; runtime syncs it from the resolved MongoDB URI
# Keep DATABASE_URL aligned with the active MONGODB_URI / DEV_MONGODB_URI (include /dbname)
DATABASE_URL=

# Optional Integrations
TOPGG_TOKEN=